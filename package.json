{
  "name": "@esmj/schema",
  "version": "0.9.2",
  "description": "Tiny extendable package for schema validation.",
  "keywords": [
    "schema",
    "validation",
    "type",
    "typescript",
    "type-safe",
    "validator",
    "parse",
    "transform",
    "inference",
    "zod",
    "yup",
    "@sinclair/typebox",
    "superstruct",
    "joi",
    "arktype"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.mjs",
      "require": "./dist/full.cjs"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "import": "./dist/string.mjs",
      "require": "./dist/string.cjs"
    },
    "./number": {
      "types": "./dist/number.d.ts",
      "import": "./dist/number.mjs",
      "require": "./dist/number.cjs"
    },
    "./array": {
      "types": "./dist/array.d.ts",
      "import": "./dist/array.mjs",
      "require": "./dist/array.cjs"
    },
    "./coerce": {
      "types": "./dist/coerce.d.ts",
      "import": "./dist/coerce.mjs",
      "require": "./dist/coerce.cjs"
    },
    "./standard": {
      "types": "./dist/standard.d.ts",
      "import": "./dist/standard.mjs",
      "require": "./dist/standard.cjs"
    }
  },
  "sideEffects": [
    "./src/string.ts",
    "./src/number.ts",
    "./src/array.ts",
    "./src/full.ts",
    "./dist/string.mjs",
    "./dist/string.cjs",
    "./dist/number.mjs",
    "./dist/number.cjs",
    "./dist/array.mjs",
    "./dist/array.cjs",
    "./dist/full.mjs",
    "./dist/full.cjs",
    "./src/coerce.ts",
    "./dist/coerce.mjs",
    "./dist/coerce.cjs",
    "./src/standard.ts",
    "./dist/standard.mjs",
    "./dist/standard.cjs",
    "./dist/chunk-3AFZRTGV.mjs",
    "./dist/chunk-5LMH7PQN.mjs",
    "./dist/chunk-PD4F2OGN.mjs",
    "./dist/chunk-RKIBKQOT.mjs",
    "./dist/chunk-RY5OCKVD.mjs"
  ],
  "typings": "dist/index.d.ts",
  "scripts": {
    "lint": "biome check --no-errors-on-unmatched",
    "lint:fix": "npm run lint -- --fix --unsafe",
    "benchmark": "node --expose-gc benchmark/benchmark.ts",
    "dev": "node_modules/.bin/tsup --dts --watch --onSuccess 'node ./dist/index.mjs'",
    "test": "npm run test:unit",
    "test:unit": "node scripts/agent/test-unit.mjs",
    "test:size": "node scripts/agent/test-size.mjs",
    "test:watch": "npm run test:unit -- --watch",
    "typecheck": "node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "preversion": "npm test && npm run typecheck && npm run lint && npm run build",
    "agent:doctor": "node scripts/agent/doctor.mjs",
    "agent:check:guidance": "node scripts/agent/check-guidance.mjs",
    "agent:lint": "npm run lint",
    "agent:lint:fix": "npm run lint:fix",
    "agent:types": "npm run typecheck",
    "agent:build": "npm run build",
    "agent:test:unit": "npm run test:unit --",
    "agent:test:tooling": "node --test --experimental-strip-types scripts/agent/__tests__/*.test.mjs",
    "agent:test:size": "npm run test:size",
    "agent:verify:quick": "node scripts/agent/verify-quick.mjs",
    "agent:verify": "node scripts/agent/verify.mjs",
    "version": "npm run changelog && git add CHANGELOG.md",
    "postversion": "git push && git push --tags",
    "commit": "node_modules/.bin/git-cz",
    "changelog": "node_modules/.bin/conventional-changelog -p angular -i CHANGELOG.md -s -r 1",
    "build": "node_modules/.bin/tsup --dts && node utils/syncSideEffects.mjs && node utils/verifyDtsEntryPoints.mjs",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjancarik/esmj-schema.git"
  },
  "author": "Miroslav Jancarik",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mjancarik/esmj-schema/issues"
  },
  "lint-staged": {
    "**/*.{ts,js,mjs}": "npm run lint"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "git-cz"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "homepage": "https://github.com/mjancarik/esmj-schema#readme",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@sinclair/typebox": "^0.34.41",
    "@zod/mini": "^4.0.0-beta.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "arktype": "^2.1.22",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "effect": "^3.17.13",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "joi": "^17.13.3",
    "lint-staged": "^16.1.6",
    "superstruct": "^2.0.2",
    "tsup": "^8.5.1",
    "valibot": "^1.4.2",
    "yup": "^1.7.0",
    "zod": "^3.25.42"
  }
}
